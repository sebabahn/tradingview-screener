using System;
using AgentTraders.Data; // Wichtiger Namespace für Datenstrukturen in Agenttrader

namespace MyConditions
{
    public class MorningStarCondition
    {
        /// <summary>
        /// Prüft das letzte Dreier-Muster auf Morning Star.
        /// </summary>
        /// <param name="bars">Die zugrunde liegende Bar-Datenquelle</param>
        /// <returns>true wenn Muster erkannt, sonst false</returns>
        public static bool IsMorningStar(IBarSeries bars)
        {
            // Wir benötigen mindestens 3 Balken
            if (bars.Count < 3)
                return false;

            // Index-Definition:
            // bars[bars.Count - 3] = Kerze -2 (Erste rote Kerze)
            // bars[bars.Count - 2] = Kerze -1 (Der Stern)
            // bars[bars.Count - 1] = Kerze  0  (Aktuelle grüne Kerze, noch "offen" oder gerade geschlossen)
            
            // Hinweis: In Backtesting-Logik prüfen wir oft auf 'Closed' Bars. 
            // Wenn Sie dies in einer Strategy als Entry-Signal nutzen, achten Sie darauf, 
            // dass Sie die Logik am Close der dritten Kerze auslösen.

            IBar firstCandle = bars[bars.Count - 3];
            IBar secondCandle = bars[bars.Count - 2];
            IBar thirdCandle = bars[bars.Count - 1];

            // 1. Erste Kerze: Long Red Candle
            bool isFirstBearish = firstCandle.Close < firstCandle.Open;
            
            // Länge des ersten Körpers (in Punkten)
            double firstBodySize = firstCandle.Open - firstCandle.Close;
            
            // Optional: Mindestgröße des ersten Körpers (z.B. größer als 0, um Rauschen zu filtern)
            if (firstBodySize <= 0) return false;

            // 2. Zweite Kerze: Small Body + Gap Down
            double secondBodySize = Math.Abs(secondCandle.Open - secondCandle.Close);
            
            // Die zweite Kerze muss deutlich kleiner sein als die erste (z.B. < 50% der ersten)
            bool isSecondSmall = secondBodySize < (firstBodySize * 0.5);
            
            // Gap Down: Das LOW der zweiten Kerze muss unter dem LOW der ersten liegen
            bool hasGapDown = secondCandle.Low < firstCandle.Low;

            if (!isFirstBearish || !isSecondSmall || !hasGapDown)
                return false;

            // 3. Dritte Kerze: Long Green Candle (Bestätigung)
            bool isThirdBullish = thirdCandle.Close > thirdCandle.Open;
            
            // Der Körper der dritten Kerze muss mehr als die Hälfte des Körpers der ersten Kerze "zurückgewinnen"
            // Mittelwert der ersten Kerze
            double firstBodyMidPoint = firstCandle.Close + (firstBodySize / 2.0);
            
            bool hasConfirmedReversal = thirdCandle.Close > firstBodyMidPoint;

            if (!isThirdBullish || !hasConfirmedReversal)
                return false;

            // Alle Kriterien erfüllt
            return true;
        }
    }
}