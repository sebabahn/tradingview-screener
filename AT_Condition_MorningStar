using System;

public class MorningStarLogic : Strategy // Oder Ihre Basisklasse, z.B. Indicator
{
    // Diese Methode kann in OnBarUpdate aufgerufen werden
    public bool IsMorningStar()
    {
        // Wir prüfen die Balken -2 (erste rote), -1 (stern) und 0 (aktuelle grüne)
        // Hinweis: In Agenttrader sind Open, Close etc. arrays/properties, die wir indizieren
        
        // 1. Erste Kerze (-2): Langer roter Körper
        double open1 = Open[-2];
        double close1 = Close[-2];
        double low1 = Low[-2];
        
        // Muss rot sein (Schlusskurs < Eröffnungskurs)
        if (close1 >= open1) return false;
        
        // Körpergröße der ersten Kerze
        double bodySize1 = open1 - close1;
        
        // Optional: Mindestkörperlänge filtern (z.B. > 0 Punkte), um Rauschen zu vermeiden
        if (bodySize1 <= 0) return false;

        // 2. Zweite Kerze (-1): Kleiner Körper + Lücke nach unten
        double open2 = Open[-1];
        double close2 = Close[-1];
        double low2 = Low[-1];
        
        // Körpergröße der zweiten Kerze (absolut)
        double bodySize2 = Math.Abs(open2 - close2);
        
        // Die zweite Kerze muss deutlich kleiner sein als die erste (z.B. < 50% der ersten)
        if (bodySize2 >= (bodySize1 * 0.5)) return false;
        
        // Lücke nach unten: Das LOW der zweiten Kerze muss unter dem LOW der ersten Kerze liegen
        if (low2 >= low1) return false;

        // 3. Dritte Kerze (0): Grüner Körper, der mehr als die Hälfte des ersten Körpers zurückgewinnt
        double open3 = Open[0];
        double close3 = Close[0];
        
        // Muss grün sein (Schlusskurs > Eröffnungskurs)
        if (close3 <= open3) return false;
        
        // Berechne den Mittelpunkt des Körpers der ersten Kerze
        double midPoint1 = close1 + (bodySize1 / 2.0);
        
        // Die dritte Kerze muss über diesem Mittelpunkt schließen
        if (close3 <= midPoint1) return false;

        // Alle Bedingungen erfüllt -> Morning Star erkannt
        return true;
    }

    public override void OnBarUpdate()
    {
        // Nur handeln, wenn genug Balken da sind
        if (Bars.Count < 3) return;

        // Prüfen auf das Muster
        bool morningStarDetected = IsMorningStar();

        if (morningStarDetected)
        {
            // Hier Ihre Aktion einfügen, z.B. EnterLong();
            Print("Morning Star Pattern erkannt!");
        }
    }
}