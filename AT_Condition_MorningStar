using System;

// Platzieren Sie diese Methode in Ihrer Strategie-Klasse oder als statische Hilfsklasse
public static class MorningStarHelper
{
    /// <summary>
    /// Prüft das letzte 3-Balken-Muster auf Morning Star.
    /// Zugriff auf Balken erfolgt über globale Indizes [-2], [-1], [0] der Strategie.
    /// </summary>
    public static bool IsMorningStar(double[] open, double[] high, double[] low, double[] close)
    {
        // Wir prüfen die letzten 3 Balken:
        // Index [-2]: Erste Kerze (Rot)
        // Index [-1]: Zweite Kerze (Stern/Doji)
        // Index [0]:  Dritte Kerze (Grün - aktuell/offen)

        double o1 = open[-2];
        double c1 = close[-2];
        double h1 = high[-2];
        double l1 = low[-2];

        double o2 = open[-1];
        double c2 = close[-1];
        double h2 = high[-1];
        double l2 = low[-1];

        double o3 = open[0]; // Aktuell (kann noch offen sein, daher oft auf Close[-1] für Bestätigung prüfen!)
        double c3 = close[0]; 
        double h3 = high[0];
        double l3 = low[0];

        // WICHTIG: Für ein verlässliches Signal sollte die dritte Kerze bereits GESCHLOSSEN sein.
        // In Agenttrader prüfen Sie in OnBarUpdate oft auf "Closed Bars".
        // Hier simulieren wir die Logik für die aktuelle Kerze. 
        // Wenn Sie es als Entry nutzen, tun Sie dies im BarUpdate von [0].

        // 1. Erste Kerze: Langer Roter Körper (Bearish)
        bool isRed = c1 < o1;
        double bodySize1 = o1 - c1;
        
        // Mindestgröße des Körpers (z.B. > 0 Punkte, oder Filter gegen sehr kleine Kerzen)
        if (bodySize1 <= 0) return false;

        // 2. Zweite Kerze: Kleiner Körper + Lücke nach unten
        double bodySize2 = Math.Abs(o2 - c2);
        
        // Die zweite Kerze muss kleiner sein als die erste (z.B. < 50% von Body1)
        bool isSmallStar = bodySize2 < (bodySize1 * 0.5);
        
        // Lücke nach unten: Das Hoch der zweiten Kerze muss unter dem Tief der ersten liegen?
        // Oder einfach: Low des Sterns < Low der roten Kerze
        bool hasGapDown = l2 < l1;

        if (!isRed || !isSmallStar || !hasGapDown)
            return false;

        // 3. Dritte Kerze: Grüner Körper, der mehr als die Hälfte des ersten Körpers zurückgewinnt
        bool isGreen = c3 > o3;
        
        // Mitte des ersten Körpers berechnen
        double midPoint = c1 + (bodySize1 / 2.0);
        
        // Die dritte Kerze muss über dem Mittelpunkt der ersten Kerze schließen
        bool confirmsReversal = c3 > midPoint;

        if (!isGreen || !confirmsReversal)
            return false;

        return true;
    }
}