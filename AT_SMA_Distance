#region Usings
using System;
using System.ComponentModel;
using System.Drawing;
using System.Xml.Serialization;
using AgenaTrader.API;
using AgenaTrader.Custom;
#endregion

namespace AgenaTrader.UserCode
{
    [Description("Prozentuale Differenz zwischen SMA50 und SMA20: ((SMA50 - SMA20) / SMA20) * 100")]
    public class SMA_Prozent_Diff : UserIndicator
    {
        #region Parameters
        [Category("Parameter")]
        [Description("Periode der schnellen SMA (Standard: 20)")]
        [Browsable(true)]
        public int FastPeriod { get; set; } = 20;

        [Category("Parameter")]
        [Description("Periode der langsamen SMA (Standard: 50)")]
        [Browsable(true)]
        public int SlowPeriod { get; set; } = 50;
        #endregion

        protected override void OnInit()
        {
            // Plot in eigenem Pane (nicht über dem Chart)
            AddOutput(new OutputDescriptor(Color.Blue, "SMA % Diff"));

            // Horizontale Null-Linie
            AddLine(new LevelLine(Color.Gray, 0, "Zero"));

            // Mindestens so viele Bars wie die langsamste SMA benötigt
            this.RequiredBarsCount = SlowPeriod;

            // Optional: Nur auf geschlossenen Bars berechnen (empfohlen für stabile Signale)
            CalculateOnClosedBar = true;
        }

        protected override void OnCalculate()
        {
            double smaFast = SMA(FastPeriod)[0];
            double smaSlow = SMA(SlowPeriod)[0];

            // Vermeide Division durch Null
            if (smaFast == 0)
                return;

            // Berechnung der Formel
            double percentDiff = ((smaSlow - smaFast) / smaFast) * 100.0;

            // Wert setzen
            Outputs[0].Set(percentDiff);

            // Farbwechsel: Grün = positiv (SMA50 > SMA20), Rot = negativ
            if (percentDiff >= 0)
                OutputDescriptor[0].PlotColor = Color.LimeGreen;
            else
                OutputDescriptor[0].PlotColor = Color.Red;
        }

        // Zugriff auf den Plot von außen (z. B. in Conditions/Strategien)
        [Browsable(false)]
        [XmlIgnore()]
        public DataSeries PercentDiff
        {
            get { return Outputs[0]; }
        }
    }
}
