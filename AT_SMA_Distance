#region Usings
using System;
using System.ComponentModel;
using System.Drawing;
using System.Xml.Serialization;
using AgenaTrader.API;
using AgenaTrader.Custom;
using AgenaTrader.Plugins;     // ← WICHTIG für IDataSeries / DataSeries
#endregion

namespace AgenaTrader.UserCode
{
    [Description("Prozentuale Differenz SMA50 zu SMA20: ((SMA50 - SMA20) / SMA20) * 100")]
    [Category("Trend")]
    public class SMA_Prozent_Diff : UserIndicator
    {
        #region Parameters
        [Category("Parameter")]
        [Description("Periode der schnellen SMA")]
        public int FastPeriod { get; set; } = 20;

        [Category("Parameter")]
        [Description("Periode der langsamen SMA")]
        public int SlowPeriod { get; set; } = 50;
        #endregion

        protected override void OnInit()
        {
            AddOutput(new OutputDescriptor(Color.Blue, "SMA % Diff"));
            AddLine(new LevelLine(Color.Gray, 0, "Zero"));

            this.RequiredBarsCount = SlowPeriod + 20; // Sicherheitspuffer
            CalculateOnClosedBar = true;
        }

        protected override void OnCalculate()
        {
            double smaFast = SMA(FastPeriod)[0];
            double smaSlow = SMA(SlowPeriod)[0];

            if (smaFast == 0 || double.IsNaN(smaFast) || double.IsNaN(smaSlow))
            {
                Outputs[0].Set(0);
                return;
            }

            double percentDiff = ((smaSlow - smaFast) / smaFast) * 100.0;

            Outputs[0].Set(percentDiff);

            // Dynamische Farbe
            OutputDescriptor[0].PlotColor = percentDiff >= 0 ? Color.LimeGreen : Color.Red;
        }

        // Wichtig für Conditions, Scanner & andere Skripte
        [Browsable(false)]
        [XmlIgnore()]
        public DataSeries PercentDiff
        {
            get { return Outputs[0]; }
        }
    }
}
