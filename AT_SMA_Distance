#region Usings
using System;
using System.ComponentModel;
using System.Drawing;
using System.Xml.Serialization;
using AgenaTrader.API;
using AgenaTrader.Custom;
using AgenaTrader.Plugins;
#endregion

namespace AgenaTrader.UserCode
{
    [Description("Prozentuale Differenz SMA50 zu SMA20")]
    public class I_SMA_Distance : UserIndicator
    {
        #region Parameters
        [Category("Parameter")]
        [Description("Periode schnelle SMA")]
        public int FastPeriod { get; set; }

        [Category("Parameter")]
        [Description("Periode langsame SMA")]
        public int SlowPeriod { get; set; }
        #endregion

        protected override void OnInit()
        {
            FastPeriod = 20;
            SlowPeriod = 50;

            Add(new OutputDescriptor(Color.Blue, "SMA % Diff"));
            AddLine(new LevelLine(Color.Gray, 0, "Zero"));

            RequiredBarsCount = SlowPeriod + 20;
            CalculateOnClosedBar = true;
        }

        protected override void OnCalculate()
        {
            double smaFast = SMA(FastPeriod)[0];
            double smaSlow = SMA(SlowPeriod)[0];

            if (smaFast == 0 || double.IsNaN(smaFast) || double.IsNaN(smaSlow))
            {
                Outputs[0].Set(0);
                return;
            }

            double percentDiff = ((smaSlow - smaFast) / smaFast) * 100.0;
            Outputs[0].Set(percentDiff);

            // Farbe über PlotColors setzen (stabilste Variante)
            PlotColors[0][0] = percentDiff >= 0 ? Color.LimeGreen : Color.Red;
        }

        [Browsable(false)]
        [XmlIgnore()]
        public IDataSeries PercentDiff
        {
            get { return Outputs[0]; }
        }
    }
}
